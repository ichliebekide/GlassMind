{
  "model": {
    "vocab_size": 260,
    "d_model": 64,
    "n_layers": 2,
    "local_kernel_size": 3,
    "dropout": 0.0,
    "telemetry_clusters": 8,
    "tie_embeddings": true,
    "activity_activation_weight": 0.35,
    "activity_delta_weight": 0.35,
    "activity_gate_weight": 0.15,
    "activity_flow_weight": 0.15
  },
  "training": {
    "steps": 200,
    "learning_rate": 0.003,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "log_every": 20,
    "seed": 17
  },
  "dataset": {
    "name": "eingebauter deutscher Mini-Korpus",
    "revision": "glassmind-v1",
    "split": "train",
    "sequence_length": 48,
    "streaming": false
  },
  "tokenizer": {
    "kind": "byte",
    "version": 1
  }
}
